edition 9;

// `rl` -- reinforcement learning on cancho-gpu, in cancho (docs/design.md).
//
//     rl grade CANCHO TASKDIR CANDIDATE SCRATCH
//
// Grades CANDIDATE (a cancho program) against the task in TASKDIR (task.spec and oracle.cho) with the compiler CANCHO, composing the
// test file at SCRATCH (removed afterwards). One JSON object on standard output:
//
//     {"id": "...", "passed": N, "of": M, "reward": R, "solved": B, "status": "ok|build_error|trap|timeout", "detail": "..."}
//
// Exit status 0 whenever a reward was produced, whatever the candidate did; 2 for a usage error or an unreadable task.

import rl.adamw;
import rl.adv;
import rl.grade;
import rl.iterate;
import rl.pack;
import rl.prompt;
import rl.report;
import rl.rollin;
import rl.rollout;
import rl.session;
import rl.side;
import rl.text;
import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.vec;

fn refuse[&h, &i](heap: &!h Heap, io: &!i Io, rule: &static [byte], message: &static [byte]) -> [heap, err_write] int {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "error");
    w = json.put_string(heap, w, rule);
    w = json.put_key(heap, w, "message");
    w = json.put_string(heap, w, message);
    w = json.end_object(heap, w);
    let out = buffer.push(heap, json.finish(w), byte_of(10));
    borrow out as &or in {
        io.error_all(io, buffer.bytes(or));
    }
    buffer.drop(heap, out);
    return 2;
}

fn path_in[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, buffer.empty(heap, 64), dir);
    p = buffer.push(heap, p, byte_of(47));
    return buffer.append(heap, p, name);
}

fn answer[&h, &i, &n, &d](heap: &!h Heap, io: &!i Io, id: &n [byte], passed: int, of: int, status: int, detail: &d [byte]) -> [heap, io_write] int {
    var reward = 0.0;
    if of > 0 {
        reward = float_of(passed) / float_of(of);
    }
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "id");
    w = json.put_string(heap, w, id);
    w = json.put_key(heap, w, "passed");
    w = json.put_int(heap, w, passed);
    w = json.put_key(heap, w, "of");
    w = json.put_int(heap, w, of);
    w = json.put_key(heap, w, "reward");
    w = json.put_float(heap, w, reward);
    w = json.put_key(heap, w, "solved");
    w = json.put_bool(heap, w, of > 0 && passed == of);
    w = json.put_key(heap, w, "status");
    w = json.put_string(heap, w, grade.status_name(status));
    w = json.put_key(heap, w, "detail");
    w = json.put_string(heap, w, detail);
    w = json.end_object(heap, w);
    let out = buffer.push(heap, json.finish(w), byte_of(10));
    borrow out as &or in {
        buffer.write(io, or);
    }
    buffer.drop(heap, out);
    return 0;
}

// Compose the test source for `only` (-1 for every case), write it to `scratch` and run it.
fn attempt[&h, &f, &x, &c, &s, &k, &o, &p, &q, &r](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, spec: &s [byte], cand: &k [byte], oracle: &o [byte], cancho: &p [byte], scratch: &q [byte], only: int) -> [heap, fs_write(""), exec(""), exec_detached, clock, poll] ((int, int, buffer.Buffer), int) {
    let (src, cases) = grade.compose(heap, spec, cand, oracle, only);
    var wrote = 0 - 1;
    borrow src as &sb in {
        wrote = fs_write(fs, scratch, buffer.bytes(sb));
    }
    buffer.drop(heap, src);
    if wrote < 0 {
        return ((1, 0, buffer.append(heap, buffer.empty(heap, 32), "cannot write the scratch file")), cases);
    }
    let run = grade.run_test(heap, exec, clock, cancho, scratch, 20, 60000);
    return (run, cases);
}

fn grade_command[&h, &i, &g, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, exec(""), exec_detached, clock, poll] int {
    if arg_count(args) != 6 {
        return refuse(heap, io, "rl.usage", "rl grade CANCHO TASKDIR CANDIDATE SCRATCH");
    }
    let cancho = arg(args, 2);
    let dir = arg(args, 3);
    let cand_path = arg(args, 4);
    let scratch = arg(args, 5);
    let spec_path = path_in(heap, dir, "task.spec");
    let oracle_path = path_in(heap, dir, "oracle.cho");
    var status = 0;
    borrow spec_path as &sp in {
        borrow oracle_path as &op in {
            let (spec_bytes, spec_failed) = text.read_file(heap, fs, buffer.bytes(sp));
            let (oracle_bytes, oracle_failed) = text.read_file(heap, fs, buffer.bytes(op));
            let (cand_bytes, cand_failed) = text.read_file(heap, fs, cand_path);
            if spec_failed != 0 || oracle_failed != 0 {
                status = refuse(heap, io, "rl.task", "the task directory has no readable task.spec and oracle.cho");
            } else if cand_failed != 0 {
                status = answer(heap, io, "?", 0, 0, 1, "the candidate cannot be read");
            } else {
                borrow spec_bytes as &sb in {
                    borrow oracle_bytes as &ob in {
                        borrow cand_bytes as &cb in {
                            let id = grade.spec_value(buffer.bytes(sb), "name:");
                            let (run, cases) = attempt(heap, fs, exec, clock, buffer.bytes(sb), buffer.bytes(cb), buffer.bytes(ob), cancho, scratch, 0 - 1);
                            let (st, passed, detail) = run;
                            var final_status = st;
                            var final_passed = passed;
                            var final_detail = detail;
                            if st == 2 {
                                // A case killed the test binary: grade the cases one at a time, so a trap costs only the cases that trap.
                                var ok = 0;
                                var k = 0;
                                while k < cases {
                                    let (one, unused) = attempt(heap, fs, exec, clock, buffer.bytes(sb), buffer.bytes(cb), buffer.bytes(ob), cancho, scratch, k);
                                    let (s1, p1, d1) = one;
                                    buffer.drop(heap, d1);
                                    if s1 == 0 && p1 == 1 {
                                        ok = ok + 1;
                                    }
                                    k = k + 1;
                                }
                                final_passed = ok;
                            }
                            borrow final_detail as &db in {
                                status = answer(heap, io, id, final_passed, cases, final_status, buffer.bytes(db));
                            }
                            buffer.drop(heap, final_detail);
                        }
                    }
                }
            }
            buffer.drop(heap, spec_bytes);
            buffer.drop(heap, oracle_bytes);
            buffer.drop(heap, cand_bytes);
        }
    }
    buffer.drop(heap, spec_path);
    buffer.drop(heap, oracle_path);
    fs_remove(fs, scratch);
    return status;
}

// `rl split TASKDIR`: "heldout" or "train" for the task named in TASKDIR/task.spec.
fn split_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), file_read] int {
    if arg_count(args) != 3 {
        return refuse(heap, io, "rl.usage", "rl split TASKDIR");
    }
    let path = path_in(heap, arg(args, 2), "task.spec");
    var status = 0;
    borrow path as &pb in {
        let (spec, failed) = text.read_file(heap, fs, buffer.bytes(pb));
        if failed != 0 {
            status = refuse(heap, io, "rl.task", "no readable task.spec in the task directory");
        } else {
            borrow spec as &sb in {
                var line = buffer.empty(heap, 16);
                if side.is_heldout(grade.spec_value(buffer.bytes(sb), "name:")) {
                    line = buffer.append(heap, line, "heldout\n");
                } else {
                    line = buffer.append(heap, line, "train\n");
                }
                borrow line as &lb in {
                    buffer.write(io, lb);
                }
                buffer.drop(heap, line);
            }
        }
        buffer.drop(heap, spec);
    }
    buffer.drop(heap, path);
    return status;
}

// `rl prompt PRIMER TASKDIR`: the primer file, then the task (signature, description, examples) and the instruction, as the text a policy is given.
// Never prints a `case:` line: the hidden cases are not part of a prompt.
fn prompt_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs(""), chat: bool) -> [heap, io_write, err_write, args, fs_read(""), file_read] int {
    if arg_count(args) != 4 {
        return refuse(heap, io, "rl.usage", "rl prompt PRIMER TASKDIR (or rl chat PRIMER TASKDIR)");
    }
    let path = path_in(heap, arg(args, 3), "task.spec");
    var status = 0;
    borrow path as &pb in {
        let (spec, failed) = text.read_file(heap, fs, buffer.bytes(pb));
        let (primer, pfailed) = text.read_file(heap, fs, arg(args, 2));
        if failed != 0 || pfailed != 0 {
            status = refuse(heap, io, "rl.task", "the primer or the task directory cannot be read");
        } else {
            borrow spec as &sb in {
                borrow primer as &rb in {
                    let out = prompt.make(heap, buffer.bytes(sb), buffer.bytes(rb), chat);
                    borrow out as &ob in {
                        buffer.write(io, ob);
                    }
                    buffer.drop(heap, out);
                }
            }
        }
        buffer.drop(heap, spec);
        buffer.drop(heap, primer);
    }
    buffer.drop(heap, path);
    return status;
}

// `rl report TASKDIR RESULTS...`: one JSON line per group (branch/train, branch/heldout, loop/train, loop/heldout, all) from the results files `rl grade` wrote:
// {"group", "tasks", "samples", "solved", "rate", "zero", "window", "high"} (docs/design.md section 20).
// `rl tasks TASKDIR RESULTS...` is the same data per task, as CSV with a header: task,kind,side,samples,solved,rate (the input of `stats ci boot`).
fn report_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs(""), csv: bool) -> [heap, io_write, err_write, args, fs_read(""), file_read] int {
    if arg_count(args) < 4 {
        if csv {
            return refuse(heap, io, "rl.usage", "rl tasks TASKDIR RESULTS...");
        }
        return refuse(heap, io, "rl.usage", "rl report TASKDIR RESULTS...");
    }
    var c = report.counters(heap);
    var rows = buffer.append(heap, buffer.empty(heap, 4096), "task,kind,side,samples,solved,rate\n");
    var status = 0;
    var a = 3;
    while a < arg_count(args) && status == 0 {
        borrow mut c as &!cb in {
            let (st, grown) = report.tally(heap, fs, arg(args, 2), arg(args, a), cb, rows);
            status = st;
            rows = grown;
        }
        a = a + 1;
    }
    if status == 1 || status == 2 {
        status = refuse(heap, io, "rl.task", "a task in the results has no readable task.spec, or its kind is neither branch nor loop");
    } else if status == 3 {
        status = refuse(heap, io, "rl.input", "a results file cannot be read");
    } else if csv {
        borrow rows as &rb in {
            buffer.write(io, rb);
        }
    } else {
        borrow c as &cr in {
            var gi = 0;
            while gi < report.group_count() {
                let base = gi * 6;
                let samples = vec.get(cr, base + 1);
                var rate = 0.0;
                if samples > 0 {
                    rate = float_of(vec.get(cr, base + 2)) / float_of(samples);
                }
                var w = json.writer(heap, 192);
                w = json.begin_object(heap, w);
                w = json.put_key(heap, w, "group");
                w = json.put_string(heap, w, report.group_name(gi));
                w = json.put_key(heap, w, "tasks");
                w = json.put_int(heap, w, vec.get(cr, base));
                w = json.put_key(heap, w, "samples");
                w = json.put_int(heap, w, samples);
                w = json.put_key(heap, w, "solved");
                w = json.put_int(heap, w, vec.get(cr, base + 2));
                w = json.put_key(heap, w, "rate");
                w = json.put_float(heap, w, rate);
                w = json.put_key(heap, w, "zero");
                w = json.put_int(heap, w, vec.get(cr, base + 3));
                w = json.put_key(heap, w, "window");
                w = json.put_int(heap, w, vec.get(cr, base + 4));
                w = json.put_key(heap, w, "high");
                w = json.put_int(heap, w, vec.get(cr, base + 5));
                w = json.end_object(heap, w);
                let out = buffer.push(heap, json.finish(w), byte_of(10));
                borrow out as &or in {
                    buffer.write(io, or);
                }
                buffer.drop(heap, out);
                gi = gi + 1;
            }
        }
    }
    buffer.drop(heap, rows);
    vec.drop(heap, c);
    return status;
}

// rl rollin PROMPTS GROUP T STEPS PAD SEED PREFIX: the inputs of a rollout (lib/rl/rollin.cho, docs/design.md section 42). PROMPTS is `cancho-gpu tokenize`'s output over the `rl chat` prompts.
fn rollin_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) != 9 {
        return refuse(heap, io, "rl.usage", "rl rollin PROMPTS GROUP T STEPS PAD SEED PREFIX");
    }
    let group = text.parse_int(arg(args, 3));
    let t = text.parse_int(arg(args, 4));
    let steps = text.parse_int(arg(args, 5));
    let pad = text.parse_int(arg(args, 6));
    let seed = text.parse_int(arg(args, 7));
    if group < 1 || t < 2 || steps < 1 || pad < 0 {
        return refuse(heap, io, "rl.usage", "GROUP and STEPS must be at least 1, T at least 2, PAD not negative");
    }
    let (status, prompts, nb) = rollin.run(heap, fs, arg(args, 2), group, t, steps, pad, seed, arg(args, 8));
    if status == 1 {
        return refuse(heap, io, "rl.rollin.input", "the prompts file cannot be read");
    }
    if status == 2 {
        return refuse(heap, io, "rl.rollin.prompts", "the prompts file has no `ids` line, or a prompt is empty");
    }
    if status == 3 {
        return refuse(heap, io, "rl.rollin.shape", "more than 32 sequences (prompts x group)");
    }
    if status == 4 {
        return refuse(heap, io, "rl.rollin.long", "a prompt and the steps do not fit in T");
    }
    if status != 0 {
        return refuse(heap, io, "rl.rollin.write", "an output file cannot be written");
    }
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "prompts");
    w = json.put_int(heap, w, prompts);
    w = json.put_key(heap, w, "sequences");
    w = json.put_int(heap, w, nb);
    w = json.end_object(heap, w);
    let out = buffer.push(heap, json.finish(w), byte_of(10));
    borrow out as &or in {
        buffer.write(io, or);
    }
    buffer.drop(heap, out);
    return 0;
}

// The one-line JSON answer of the rollout commands: {"<a>": x, "<b>": y}.
fn pair_answer[&h, &i](heap: &!h Heap, io: &!i Io, a: &static [byte], x: int, b: &static [byte], y: int) -> [heap, io_write] int {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, a);
    w = json.put_int(heap, w, x);
    w = json.put_key(heap, w, b);
    w = json.put_int(heap, w, y);
    w = json.end_object(heap, w);
    let out = buffer.push(heap, json.finish(w), byte_of(10));
    borrow out as &or in {
        buffer.write(io, or);
    }
    buffer.drop(heap, out);
    return 0;
}

// rl complete IDS GROUP STEPS PREFIX: a decode's draws into PREFIX.ids (for `cancho-gpu detokenize`) and PREFIX.meta (lib/rl/rollout.cho, docs/design.md section 42).
fn complete_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) != 6 {
        return refuse(heap, io, "rl.usage", "rl complete IDS GROUP STEPS PREFIX");
    }
    let group = text.parse_int(arg(args, 3));
    let steps = text.parse_int(arg(args, 4));
    if group < 1 || steps < 1 {
        return refuse(heap, io, "rl.usage", "GROUP and STEPS must be at least 1");
    }
    let (status, seqs, stopped) = rollout.complete(heap, fs, arg(args, 2), group, steps, arg(args, 5));
    if status == 1 {
        return refuse(heap, io, "rl.complete.input", "the draws file cannot be read");
    }
    if status == 2 {
        return refuse(heap, io, "rl.complete.shape", "the draws are not a whole number of rows of STEPS numbers");
    }
    if status != 0 {
        return refuse(heap, io, "rl.complete.write", "an output file cannot be written");
    }
    return pair_answer(heap, io, "sequences", seqs, "stopped", stopped);
}

// rl extract DEC PREFIX: the candidate program of each decoded reply, PREFIX.k.cho (lib/rl/rollout.cho).
fn extract_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) != 4 {
        return refuse(heap, io, "rl.usage", "rl extract DEC PREFIX");
    }
    let (status, count) = rollout.extract(heap, fs, arg(args, 2), arg(args, 3));
    if status == 1 {
        return refuse(heap, io, "rl.extract.input", "the decoded replies cannot be read");
    }
    if status != 0 {
        return refuse(heap, io, "rl.extract.write", "a candidate file cannot be written");
    }
    return pair_answer(heap, io, "programs", count, "written", count);
}

// rl samples META PROMPTS TASKS RESULTS OUT: the samples file for `rl pack` (lib/rl/rollout.cho).
fn samples_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) != 7 {
        return refuse(heap, io, "rl.usage", "rl samples META PROMPTS TASKS RESULTS OUT");
    }
    let (status, count) = rollout.samples(heap, fs, arg(args, 2), arg(args, 3), arg(args, 4), arg(args, 5), arg(args, 6));
    if status == 1 {
        return refuse(heap, io, "rl.samples.input", "the meta, prompts or tasks file cannot be read");
    }
    if status == 2 {
        return refuse(heap, io, "rl.samples.meta", "a line of the meta file is not `r task stopped n: ids`");
    }
    if status == 3 {
        return refuse(heap, io, "rl.samples.task", "a task index is past the tasks file");
    }
    if status != 0 {
        return refuse(heap, io, "rl.samples.write", "the samples file cannot be written");
    }
    return pair_answer(heap, io, "samples", count, "written", count);
}

// rl pack SAMPLES PREFIX NB T PAD: the samples (JSON lines) into K = ceil(kept / NB) batches of [NB, T], PREFIX.tokens.i32 and PREFIX.weights.f64 (lib/rl/pack.cho). One JSON
// object on standard output: how many samples, how many kept (non-zero advantage), the batches and the completion tokens. Nothing is written when none is kept.
fn pack_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) != 7 {
        return refuse(heap, io, "rl.usage", "rl pack SAMPLES PREFIX NB T PAD");
    }
    let nb = text.parse_int(arg(args, 4));
    let t = text.parse_int(arg(args, 5));
    let pad = text.parse_int(arg(args, 6));
    if nb < 1 || t < 2 || pad < 0 {
        return refuse(heap, io, "rl.usage", "NB and T must be at least 1 and 2, PAD not negative");
    }
    let (status, total, kept, ntok) = pack.run(heap, fs, arg(args, 2), arg(args, 3), nb, t, pad);
    if status == 1 {
        return refuse(heap, io, "rl.pack.input", "the samples file cannot be read");
    }
    if status == 2 {
        return refuse(heap, io, "rl.pack.sample", "a line is not {group, reward, prompt, completion} with integer token lists");
    }
    if status == 4 {
        return refuse(heap, io, "rl.pack.long", "a kept sample is longer than T");
    }
    if status != 0 {
        return refuse(heap, io, "rl.pack.write", "an output file cannot be written");
    }
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "samples");
    w = json.put_int(heap, w, total);
    w = json.put_key(heap, w, "kept");
    w = json.put_int(heap, w, kept);
    w = json.put_key(heap, w, "batches");
    w = json.put_int(heap, w, (kept + nb - 1) / nb);
    w = json.put_key(heap, w, "completion_tokens");
    w = json.put_int(heap, w, ntok);
    w = json.end_object(heap, w);
    let out = buffer.push(heap, json.finish(w), byte_of(10));
    borrow out as &or in {
        buffer.write(io, or);
    }
    buffer.drop(heap, out);
    return 0;
}

// rl adamw CONFIG PARAMS M V OUT GRAD...: the optimiser step of one update (lib/rl/adamw.cho). CONFIG is JSON: {"step": t, "lr": ..., "beta1", "beta2", "eps", "weight_decay", "clip"}
// (step and lr are required; the defaults are 0.9, 0.999, 1e-8, 0 and no clipping). M and V are the moments files, or "-" for zeros (the first update). The GRAD files are summed.
// Writes OUT.params.f64, OUT.m.f64 and OUT.v.f64; one JSON object on standard output: the number of values, the step, the gradient norm before clipping and the factor applied.
fn hyper_of[&c](cfg: &c [byte]) -> [] (adamw.Hyper, bool) {
    let bad = adamw.Hyper { step: 0, lr: 0.0, b1: 0.0, b2: 0.0, eps: 0.0, wd: 0.0, clip: 0.0 };
    if len(cfg) > 2000 {
        return (bad, false);
    }
    var ok = false;
    var hy = bad;
    region a {
        let tape = alloc_slice[a](3 * (len(cfg) + 8), 0);
        let st = alloc_slice[a](2, 0);
        let nodes = json.parse_with(cfg, tape, st);
        if nodes > 0 && json.is_object(tape, 0) {
            let s = json.get(cfg, tape, 0, "step");
            let l = json.get(cfg, tape, 0, "lr");
            if s >= 0 && l >= 0 && json.is_int(tape, s) && json.is_number(tape, l) {
                var b1 = 0.9;
                var b2 = 0.999;
                var eps = 0.00000001;
                var wd = 0.0;
                var clip = 0.0;
                let nb1 = json.get(cfg, tape, 0, "beta1");
                if nb1 >= 0 {
                    b1 = json.to_float(cfg, tape, nb1);
                }
                let nb2 = json.get(cfg, tape, 0, "beta2");
                if nb2 >= 0 {
                    b2 = json.to_float(cfg, tape, nb2);
                }
                let ne = json.get(cfg, tape, 0, "eps");
                if ne >= 0 {
                    eps = json.to_float(cfg, tape, ne);
                }
                let nw = json.get(cfg, tape, 0, "weight_decay");
                if nw >= 0 {
                    wd = json.to_float(cfg, tape, nw);
                }
                let nc = json.get(cfg, tape, 0, "clip");
                if nc >= 0 {
                    clip = json.to_float(cfg, tape, nc);
                }
                hy = adamw.Hyper { step: json.to_int(cfg, tape, s), lr: json.to_float(cfg, tape, l), b1: b1, b2: b2, eps: eps, wd: wd, clip: clip };
                ok = hy.step >= 1;
            }
        }
    }
    return (hy, ok);
}

fn adamw_command[&h, &i, &g, &f](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read] int {
    if arg_count(args) < 8 {
        return refuse(heap, io, "rl.usage", "rl adamw CONFIG PARAMS M V OUT GRAD...");
    }
    let (cfg, cfg_failed) = text.read_file(heap, fs, arg(args, 2));
    let (params, pf) = text.read_file(heap, fs, arg(args, 3));
    var mom_m = buffer.empty(heap, 8);
    var mom_v = buffer.empty(heap, 8);
    var mf = 0;
    if !bytes.equal(arg(args, 4), "-") {
        buffer.drop(heap, mom_m);
        let (mb, f1) = text.read_file(heap, fs, arg(args, 4));
        mom_m = mb;
        mf = f1;
    }
    var vf = 0;
    if !bytes.equal(arg(args, 5), "-") {
        buffer.drop(heap, mom_v);
        let (vb, f2) = text.read_file(heap, fs, arg(args, 5));
        mom_v = vb;
        vf = f2;
    }
    var status = 0;
    var acc = buffer.empty(heap, 8);
    var gfail = 0;
    var k = 7;
    while k < arg_count(args) && gfail == 0 {
        let (gb, gf) = text.read_file(heap, fs, arg(args, k));
        if gf != 0 {
            gfail = 1;
            buffer.drop(heap, gb);
        } else if k == 7 {
            buffer.drop(heap, acc);
            acc = gb;
        } else {
            var mismatch = false;
            borrow acc as &ar in {
                borrow gb as &gr in {
                    if len(buffer.bytes(ar)) != len(buffer.bytes(gr)) {
                        mismatch = true;
                    }
                }
            }
            if mismatch {
                gfail = 2;
                buffer.drop(heap, gb);
            } else {
                var summed = buffer.empty(heap, 8);
                borrow acc as &ar in {
                    borrow gb as &gr in {
                        buffer.drop(heap, summed);
                        summed = adamw.add(heap, buffer.bytes(ar), buffer.bytes(gr));
                    }
                }
                buffer.drop(heap, acc);
                buffer.drop(heap, gb);
                acc = summed;
            }
        }
        k = k + 1;
    }
    if cfg_failed != 0 || pf != 0 || mf != 0 || vf != 0 || gfail == 1 {
        status = refuse(heap, io, "rl.adamw.input", "a file cannot be read");
    } else {
        borrow cfg as &cb in {
            let (hy, ok) = hyper_of(buffer.bytes(cb));
            if !ok {
                status = refuse(heap, io, "rl.adamw.config", "CONFIG is JSON with an integer step of at least 1 and a number lr");
            } else if gfail == 2 {
                status = refuse(heap, io, "rl.adamw.shape", "the gradient files differ in length");
            } else {
                borrow params as &pr in {
                    borrow mom_m as &mr in {
                        borrow mom_v as &vr in {
                            borrow acc as &ar in {
                                let n = len(buffer.bytes(pr));
                                let fresh = bytes.equal(arg(args, 4), "-");
                                if bytes.equal(arg(args, 5), "-") != fresh {
                                    status = refuse(heap, io, "rl.usage", "M and V are both files or both \"-\"");
                                } else if n % 8 != 0 || len(buffer.bytes(ar)) != n || !fresh && (len(buffer.bytes(mr)) != n || len(buffer.bytes(vr)) != n) {
                                    status = refuse(heap, io, "rl.adamw.shape", "PARAMS, M, V and the gradients must be binary64 arrays of the same length");
                                } else {
                                    let gn = adamw.norm(buffer.bytes(ar));
                                    let coef = adamw.coefficient(gn, hy.clip);
                                    let (po, mo, vo) = adamw.update(heap, hy, buffer.bytes(pr), buffer.bytes(mr), buffer.bytes(vr), buffer.bytes(ar), coef, fresh);
                                    var wrote = 0;
                                    var names = 0;
                                    while names < 3 {
                                        var path = buffer.append(heap, buffer.empty(heap, 64), arg(args, 6));
                                        if names == 0 {
                                            path = buffer.append(heap, path, ".params.f64");
                                        } else if names == 1 {
                                            path = buffer.append(heap, path, ".m.f64");
                                        } else {
                                            path = buffer.append(heap, path, ".v.f64");
                                        }
                                        borrow path as &pp in {
                                            if names == 0 {
                                                borrow po as &ob in {
                                                    if fs_write(fs, buffer.bytes(pp), buffer.bytes(ob)) < 0 {
                                                        wrote = 1;
                                                    }
                                                }
                                            } else if names == 1 {
                                                borrow mo as &ob in {
                                                    if fs_write(fs, buffer.bytes(pp), buffer.bytes(ob)) < 0 {
                                                        wrote = 1;
                                                    }
                                                }
                                            } else {
                                                borrow vo as &ob in {
                                                    if fs_write(fs, buffer.bytes(pp), buffer.bytes(ob)) < 0 {
                                                        wrote = 1;
                                                    }
                                                }
                                            }
                                        }
                                        buffer.drop(heap, path);
                                        names = names + 1;
                                    }
                                    buffer.drop(heap, po);
                                    buffer.drop(heap, mo);
                                    buffer.drop(heap, vo);
                                    if wrote != 0 {
                                        status = refuse(heap, io, "rl.adamw.write", "an output file cannot be written");
                                    } else {
                                        var w = json.writer(heap, 128);
                                        w = json.begin_object(heap, w);
                                        w = json.put_key(heap, w, "n");
                                        w = json.put_int(heap, w, n / 8);
                                        w = json.put_key(heap, w, "step");
                                        w = json.put_int(heap, w, hy.step);
                                        w = json.put_key(heap, w, "grad_norm");
                                        w = json.put_float(heap, w, gn);
                                        w = json.put_key(heap, w, "coef");
                                        w = json.put_float(heap, w, coef);
                                        w = json.end_object(heap, w);
                                        let out = buffer.push(heap, json.finish(w), byte_of(10));
                                        borrow out as &or in {
                                            buffer.write(io, or);
                                        }
                                        buffer.drop(heap, out);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, cfg);
    buffer.drop(heap, params);
    buffer.drop(heap, mom_m);
    buffer.drop(heap, mom_v);
    buffer.drop(heap, acc);
    return status;
}

// rl ask SHELLCOMMAND LINE...: runs `sh -c SHELLCOMMAND` as a session (lib/rl/session.cho, docs/design.md section 46), sends each LINE and prints the reply line to each; the test of the session helper.
fn ask_command[&h, &i, &g, &x](heap: &!h Heap, io: &!i Io, args: &g Args, exec: &x Exec("")) -> [heap, io_write, err_write, args, exec(""), pipe_write, pipe_read] int {
    if arg_count(args) < 4 {
        return refuse(heap, io, "rl.usage", "rl ask SHELLCOMMAND LINE...");
    }
    var cmd = buffer.append(heap, buffer.empty(heap, 64), "-c\0");
    cmd = buffer.append(heap, cmd, arg(args, 2));
    cmd = buffer.push(heap, cmd, byte_of(0));
    var status = 0;
    borrow cmd as &cb in {
        match session.start(heap, exec, "/bin/sh", buffer.bytes(cb), "PATH=/usr/bin:/bin\0") {
            session.Started::Failed(e) => {
                status = refuse(heap, io, "rl.ask.spawn", "the program cannot be started");
            }
            session.Started::Ok(first) => {
                var s = first;
                var k = 3;
                while k < arg_count(args) && status == 0 {
                    let (next, reply, st) = session.ask(heap, s, arg(args, k));
                    s = next;
                    if st != 0 {
                        status = refuse(heap, io, "rl.ask.session", "the program stopped answering");
                        buffer.drop(heap, reply);
                    } else {
                        let line = buffer.push(heap, reply, byte_of(10));
                        borrow line as &lr in {
                            buffer.write(io, lr);
                        }
                        buffer.drop(heap, line);
                        k = k + 1;
                    }
                }
                session.finish(heap, s);
            }
        }
    }
    buffer.drop(heap, cmd);
    return status;
}

// rl iterate SETTINGS OUT ADAPTERS: one GRPO iteration (lib/rl/iterate.cho, docs/design.md section 47). SETTINGS is a `key value` file naming the programs and numbers (see iterate.run);
// OUT is a directory that holds kv pre dec cand train work; ADAPTERS is the current adapters (binary64). Exit 0 when the stages ran, 1 when one failed (named on standard error), 2 for usage.
fn iterate_command[&h, &i, &g, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &g Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, exec(""), clock, pipe_write, pipe_read] int {
    if arg_count(args) != 5 {
        return refuse(heap, io, "rl.usage", "rl iterate SETTINGS OUT ADAPTERS");
    }
    let (cfg, failed) = text.read_file(heap, fs, arg(args, 2));
    var status = 0;
    if failed != 0 {
        status = refuse(heap, io, "rl.iterate.settings", "the settings file cannot be read");
    } else {
        borrow cfg as &cb in {
            status = iterate.run(heap, io, fs, exec, clock, buffer.bytes(cb), arg(args, 3), arg(args, 4));
        }
    }
    buffer.drop(heap, cfg);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    var status = 0;
    borrow args as &g in {
        borrow fs as &f in {
            borrow exec as &x in {
                borrow clock as &c in {
                    borrow mut heap as &!h in {
                        borrow mut io as &!i in {
                            if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "grade") {
                                status = grade_command(h, i, g, f, x, c);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "split") {
                                status = split_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "prompt") {
                                status = prompt_command(h, i, g, f, false);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "chat") {
                                status = prompt_command(h, i, g, f, true);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "report") {
                                status = report_command(h, i, g, f, false);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "tasks") {
                                status = report_command(h, i, g, f, true);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "pack") {
                                status = pack_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "adamw") {
                                status = adamw_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "rollin") {
                                status = rollin_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "complete") {
                                status = complete_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "extract") {
                                status = extract_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "samples") {
                                status = samples_command(h, i, g, f);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "iterate") {
                                status = iterate_command(h, i, g, f, x, c);
                            } else if arg_count(g) >= 2 && bytes.equal(arg(g, 1), "ask") {
                                status = ask_command(h, i, g, x);
                            } else {
                                status = refuse(h, i, "rl.usage", "the commands are `rl grade`, `rl split`, `rl prompt`, `rl chat`, `rl report`, `rl tasks`, `rl pack`, `rl adamw`, `rl rollin`, `rl complete`, `rl extract`, `rl samples`, `rl iterate` and `rl ask`");
                            }
                        }
                    }
                }
            }
        }
    }
    release(args);
    release(fs);
    release(exec);
    release(clock);
    release(heap);
    release(io);
    return status;
}
