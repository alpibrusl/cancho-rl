name: largest_pow2_le
ret: int
kind: loop
sig: fn largest_pow2_le(n: int) -> [] int
desc: The largest power of two (1, 2, 4, 8, ...) that is at most n. Domain: 1 <= n <= 1000000000.
example: largest_pow2_le(10) == 8
example: largest_pow2_le(16) == 16
example: largest_pow2_le(1) == 1
