name: count_squares_upto
ret: int
kind: loop
sig: fn count_squares_upto(n: int) -> [] int
desc: How many of the numbers 1, 2, ..., n are perfect squares (1, 4, 9, 16, ...). count_squares_upto(10) is 3. Domain: 0 <= n <= 1000000.
example: count_squares_upto(10) == 3
example: count_squares_upto(16) == 4
example: count_squares_upto(0) == 0
