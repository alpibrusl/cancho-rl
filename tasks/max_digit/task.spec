name: max_digit
ret: int
sig: fn max_digit(n: int) -> [] int
desc: The largest decimal digit of n. max_digit(0) is 0. Domain: 0 <= n <= 1000000000.
example: max_digit(1234) == 4
example: max_digit(909) == 9
example: max_digit(0) == 0
