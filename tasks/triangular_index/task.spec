name: triangular_index
ret: int
kind: loop
sig: fn triangular_index(n: int) -> [] int
desc: The smallest k such that 1 + 2 + ... + k is at least n. triangular_index(10) is 4 and triangular_index(11) is 5. Domain: 1 <= n <= 100000.
example: triangular_index(10) == 4
example: triangular_index(11) == 5
example: triangular_index(1) == 1
