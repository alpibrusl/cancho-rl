name: power
ret: int
kind: loop
sig: fn power(b: int, e: int) -> [] int
desc: b multiplied by itself e times; power(b, 0) is 1. Domain: -10 <= b <= 10, 0 <= e <= 10.
example: power(2, 10) == 1024
example: power(5, 0) == 1
example: power(-2, 3) == -8
