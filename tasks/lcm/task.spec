name: lcm
ret: int
sig: fn lcm(a: int, b: int) -> [] int
desc: The least common multiple of a and b: the smallest positive number both divide. Domain: 1 <= a, b <= 30000.
example: lcm(4, 6) == 12
example: lcm(5, 7) == 35
example: lcm(1, 9) == 9
