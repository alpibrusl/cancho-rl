name: is_valid_triangle
ret: bool
kind: branch
sig: fn is_valid_triangle(a: int, b: int, c: int) -> [] bool
desc: True when segments of lengths a, b and c can form a triangle with positive area: each length is less than the sum of the other two. Domain: 1 <= a, b, c <= 1000.
example: is_valid_triangle(3, 4, 5) == true
example: is_valid_triangle(1, 2, 3) == false
example: is_valid_triangle(2, 2, 2) == true
